# Copy to .env (never commit .env). Values come from Supabase Dashboard -> Connect / Project Settings -> API Keys.
# Only the PUBLIC values belong here; the service_role / secret key must never use a VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
