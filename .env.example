# Copy to .env (never commit .env). Values come from Supabase Dashboard -> Connect / Project Settings -> API Keys.
# Only the PUBLIC values belong here; the service_role / secret key must never use a VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older Supabase screens call it the anon key; this name also works:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY (used by api/delete-user.js). Set in Vercel -> Settings -> Environment Variables as "Sensitive".
# Never prefix with VITE_ and never commit the real value.
# SUPABASE_SECRET_KEY=your-secret-key
